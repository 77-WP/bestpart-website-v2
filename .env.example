VITE_SUPABASE_URL=
# Publishable key (sb_publishable_…) — ใช้ key นี้ก่อน ถ้าไม่มีจะถอยไปใช้ VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT — ยังใช้ได้เพื่อ backward-compat แต่ควรย้ายไป PUBLISHABLE_KEY
VITE_SUPABASE_ANON_KEY=

# Forced-close override: ISO datetime (Asia/Bangkok). When set and current time is before it,
# shop is forced closed with "ปิดชั่วคราว · เปิดอีกครั้ง {date} {time}" message.
# Example: VITE_FORCE_CLOSED_UNTIL=2026-10-06T10:00:00+07:00
VITE_FORCE_CLOSED_UNTIL=

# Preview-only open: set to "true" ONLY on Vercel Preview deployments (VITE_VERCEL_ENV=preview).
# Has NO effect on production or local dev. Use for QA review without affecting live hours.
VITE_PREVIEW_OPEN=
